{
  "name": "hoverkraft/get-php-versions",
  "description": "Resolve released PHP versions using Composer project constraints",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.4.1",
    "composer/semver": "^3.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.4"
  },
  "autoload": {
    "psr-4": {
      "Hoverkraft\\PhpVersions\\": "src/"
    }
  },
  "scripts": {
    "test": "phpunit --bootstrap vendor/autoload.php src/PhpVersionsTest.php",
    "test:ci": "@test --log-junit=junit.xml --coverage-cobertura=cobertura.xml --coverage-filter=src"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": false
  }
}
